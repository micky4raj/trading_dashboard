# Copy this file to `.env` (never commit the real .env) and fill in your values.
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# App-level login password. Leave blank for pure localhost use. REQUIRED
# before deploying anywhere network-reachable (Docker host, cloud, etc.) —
# Dhan credentials alone don't stop a stranger from using YOUR session.
APP_PASSWORD=

# Optional tuning
TRADING_DB_PATH=data/trading_journal.db
DEFAULT_SLIPPAGE_PCT=0.05
PAPER_STARTING_CAPITAL=1000000
RISK_FREE_RATE_ANNUAL=0.065
